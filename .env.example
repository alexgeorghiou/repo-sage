# Copy to .env and adjust. Every setting is optional; defaults run fully offline.
REPO_SAGE_STORE=memory            # memory | postgres
REPO_SAGE_DATABASE_URL=postgresql://sage:sage@localhost:5432/sage
REPO_SAGE_EMBEDDER=hashing        # hashing | openai
REPO_SAGE_EMBEDDING_MODEL=text-embedding-3-small
REPO_SAGE_EMBEDDING_DIM=384       # use 1536 for text-embedding-3-small at full size
REPO_SAGE_LLM=fake                # fake | anthropic | openai
REPO_SAGE_LLM_MODEL=              # defaults: claude-opus-5-5 / gpt-4.1-mini
REPO_SAGE_RERANKER=lexical        # lexical | cross-encoder | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
